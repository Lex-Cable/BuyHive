APP_NAME=BuyHive
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=buyhive_marketplace
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# BuyHive Configurable Marketplace Rules (overridable by separate Management System)
BUYHIVE_DEFAULT_COMMISSION_RATE=12.00
BUYHIVE_SANDBOX_PAYMENTS=true
BUYHIVE_MANAGEMENT_WEBHOOK_SECRET=replace-with-hmac-secret

# M-Pesa Daraja Sandbox Configuration
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=${APP_URL}/api/webhooks/mpesa

# Card & PayPal Provider Configuration
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
